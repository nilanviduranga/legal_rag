# API_BASE_URL=http://127.0.0.1:8001/
API_BASE_URL=https://admin.ludexora.live/
CLIENT_BASE_URL=https://ludexora.live
API_TOKEN=your-secret-token-here

# --- LLM provider ---
# Set ONLY the key for the provider you want to use.
# The system auto-detects: if GROQ_API_KEY is present it uses Groq,
# if GEMINI_API_KEY is present it uses Gemini.
# If both are set, explicitly pick one with LLM_PROVIDER.

GROQ_API_KEY=your-groq-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides:
# LLM_PROVIDER=groq          # force provider: groq | gemini
# LLM_MODEL=llama-3.1-8b-instant   # override the default model for that provider
